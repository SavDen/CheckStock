  "narrative": {
    "northStar": "Quiet Industrial Ledger",
    "overview": "A calm, practical workspace for a warehouse manager reading quantities throughout the day. Warm paper surrounds white working surfaces; forest navigation anchors the tool, while lime marks the current destination. Compact type and consistent alignment give operational information priority.",
    "keyCharacteristics": [
      "Dense, legible working surfaces.",
      "Restrained color with explicit status labels.",
      "Geometric SVG icons and tabular quantities."
    ],
    "rules": [
      {
        "name": "The Status Has Words Rule",
        "body": "Pair status color with a readable label or quantity context.",
        "section": "colors"
      },
      {
        "name": "The Flat Workspace Rule",
        "body": "Reserve floating depth for temporary overlays and action feedback.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do keep quantities tabular and right-aligned in working tables.",
      "Do preserve readable status labels alongside color.",
      "Do retain local Onest and the shared SVG icon vocabulary."
    ],
    "donts": [
      "Don't mix transit quantities into the physical-stock ledger.",
      "Don't use floating card shadows for ordinary resting panels.",
      "Don't remove table columns to fit a narrow viewport; keep contained horizontal scrolling."
    ]
  }
